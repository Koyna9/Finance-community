# Example settings. Copy this file to .env.local and fill in your own values:
#   cp .env.example .env.local
# .env.local is git-ignored. NEVER commit real passwords, secrets or API keys.
# Online (TrueFoundry) the same names are set as secrets / environment variables instead.
# Full explanation: CLAUDE.md section 4.

# --- Local PostgreSQL (docker-compose.yml reads these to create the database) ---
POSTGRES_DB=my_jobs_db
POSTGRES_USER=my_db_user
POSTGRES_PASSWORD=change-me-db-password
# Must use the same user, password and database name as above.
DATABASE_URL=postgres://my_db_user:change-me-db-password@localhost:5432/my_jobs_db

# --- Payload CMS: any long random string, e.g. the output of `openssl rand -hex 32` ---
PAYLOAD_SECRET=change-me-long-random-string

# --- fantastic.jobs API key: only needed to fetch new jobs (scripts/backfill.mjs, npm run sync).
# Ask the project owner privately; leave empty if you only work on the site.
FANTASTIC_JOBS_KEY=

# --- Site ---
# Thin-page minimum: 1 locally, 3 in production.
MIN_JOBS_PER_PAGE=1
SITE_URL=http://localhost:3000

# --- Local Redis cache (docker-compose.yml reads REDIS_PASSWORD; the app reads REDIS_URL) ---
# Leave REDIS_URL empty to run without the cache (the site then reads PostgreSQL directly).
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@localhost:6379

# --- Optional (defaults shown in brackets) ---
# REDIS_CA_CERT=          # production only, if the cloud's Redis TLS needs its own CA certificate (GCP)
# CACHE_TTL_SECONDS=900   # how long cached page data is kept
# MAX_JOBS_PER_RUN=5      # nightly sync: most new jobs per run
# MIN_CREDITS_RESERVE=10  # nightly sync: API credits never spent
# EXPIRED_TIME_FRAME=1d   # nightly sync: how far back to look for closed jobs (1m once on go-live day)
