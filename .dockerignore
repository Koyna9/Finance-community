# Files never copied into the Docker image (see Dockerfile).
# Secrets: settings come from TrueFoundry secrets / environment variables, never from a file.
.env*
# Rebuilt inside the image
node_modules
.next
next-env.d.ts
tsconfig.tsbuildinfo
# Not needed in the image
.git
.DS_Store
npm-debug.log*
# data/ IS copied (committed): the release job's load-jobs reads it.
# Except the saved lists of closed job ids (~35 MB): written by past sync runs, never read by
# anything (load-jobs reads only the *-active-* files).
data/sync/*-expired-*.json
